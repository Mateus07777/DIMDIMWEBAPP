@model Cliente
@{ ViewData["Title"] = "Excluir"; }
<h1>Excluir registro #@Model.Id?</h1><div class="card form"><p>Esta operação remove o registro do banco.</p><dl><dt>Nome</dt><dd>@Model.Nome</dd><dt>E-mail</dt><dd>@Model.Email</dd><dt>CPF</dt><dd>@Model.Cpf</dd></dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><input type="hidden" asp-for="Id" /><div class="actions"><button class="button danger" type="submit">Confirmar exclusão</button><a asp-action="Index">Cancelar</a></div></form></div>
