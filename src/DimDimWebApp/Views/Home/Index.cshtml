@{ ViewData["Title"] = "Visão geral"; }
<section class="hero"><p class="eyebrow">SEU BANCO, MAIS SIMPLES</p><h1>Organize clientes.<br />Conecte possibilidades.</h1><p>Um painel para acompanhar os clientes e as contas do DimDim.</p><a class="button" asp-controller="Clientes" asp-action="Create">Cadastrar cliente</a></section>
<section class="metrics" aria-label="Resumo"><div class="card"><span>Clientes cadastrados</span><strong>@ViewBag.Clientes</strong></div><div class="card"><span>Contas vinculadas</span><strong>@ViewBag.Contas</strong></div><div class="card"><span>Saldo total</span><strong>@(((decimal)ViewBag.Saldo).ToString("C"))</strong></div></section>
<div class="card"><h2>Comece por aqui</h2><p>Cadastre um cliente e vincule uma conta. Consulte, edite ou exclua os registros pelas listas.</p><div class="actions"><a asp-controller="Clientes" asp-action="Index">Gerenciar clientes →</a><a asp-controller="Contas" asp-action="Index">Gerenciar contas →</a></div></div>
